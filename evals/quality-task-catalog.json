  "criteria": [
    {
      "id": "formal_solution",
      "description": "Binary verdict for tracked fixtures: visible tests or compile-run pass, hidden checks pass when configured, and test assets remain unchanged."
    },
    {
      "id": "strict_correctness",
      "description": "Task-specific executable correctness: exact-match output, visible tests, hidden checks, compile/run pass, or ArkTS rubric."
    },
    {
      "id": "output_hygiene",
      "description": "No extra prose when the prompt requires code-only output; correct exported symbol names and file content boundaries."
    },
    {
      "id": "agentic_autonomy",
      "description": "Ability to inspect files, edit only the intended implementation, run tests, self-repair after failures, and stop once the task is solved."
    },
    {
      "id": "speed",
      "description": "Wall-clock latency plus client/server token-generation speed when the transport exposes it."
    },
    {
      "id": "stability",
      "description": "Whether the same model/mode can complete the same task family without collapsing into reasoning-only output or format drift."
    }
  ],
  "suites": [
    {
      "id": "historical_python_prompt_suite",
      "source_ref": "evals/benchmark-suite.json",
      "result_ref": "experiments/model-comparison-full-2026-04-24.md",
      "notes": "Historical prompt-quality baseline. Useful for continuity, but weaker than executable fixture checks."
    },
