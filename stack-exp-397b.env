# === ЭКСПЕРИМЕНТ V100 RAM OVERFLOW 2026-04 ===
# Запуск: bash scripts/stack.sh restart --env stack-exp-397b.env
# (если stack.sh не поддерживает --env, скопировать в stack-exp.env и запустить отдельно)
#
# Не трогает продакшн: отдельный контейнер и порт.
# Остановить: docker stop llamacpp-exp-p8002 && docker rm llamacpp-exp-p8002

LLAMA_CONTAINER=llamacpp-exp-p8002
LLAMA_HOST_PORT=8002          # отдельный порт, не мешает продакшн (8001)

LLAMA_MODELS_HOST_DIR=/data/shared/<user>/models

# Путь менять перед каждым run:
#   Run 1 (IQ1_M,  ~91.6 GB): /models/Qwen3.5-397B-A17B-GGUF/IQ1_M/<filename>.gguf
#   Run 2 (IQ2_XXS, ~106.6 GB): /models/Qwen3.5-397B-A17B-GGUF/IQ2_XXS/<filename>.gguf
#   Run 3 (IQ2_XS,  ~118.7 GB): /models/Qwen3.5-397B-A17B-GGUF/IQ2_XS/<filename>.gguf
LLAMA_MODEL_PATH=/models/Qwen3.5-397B-A17B-GGUF/IQ1_M/Qwen_Qwen3.5-397B-A17B-IQ1_M.gguf

LLAMA_GPU_DEVICES=0,1,2
LLAMA_GPU_LAYERS=100          # llama.cpp сам spillover в RAM при нехватке VRAM
LLAMA_CTX_SIZE=8192           # фиксированный маленький контекст для чистого замера скорости
LLAMA_SPLIT_MODE=layer
LLAMA_TENSOR_SPLIT=1,1,1
LLAMA_PARALLEL=1
LLAMA_CACHE_TYPE_K=q8_0
LLAMA_CACHE_TYPE_V=q8_0
LLAMA_TEMP=0.6
LLAMA_TOP_P=0.95
LLAMA_TOP_K=20
LLAMA_MIN_P=0.0
