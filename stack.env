# LLM stack configuration

LLAMA_CONTAINER=llamacpp-server-p8001
LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA_HOST_PORT=8001
LLAMA_CONTAINER_PORT=8080
LLAMA_MODELS_HOST_DIR=/data/shared/<user>/models
LLAMA_MODEL_PATH=/models/Qwen3.5-122B-A10B-GGUF/UD-Q4_K_XL/Qwen3.5-122B-A10B-UD-Q4_K_XL-00001-of-00003.gguf
LLAMA_GPU_DEVICES=0,1,2
LLAMA_GPU_LAYERS=100
LLAMA_CTX_SIZE=262144
LLAMA_BATCH_SIZE=2048
LLAMA_UBATCH_SIZE=2048
LLAMA_SPLIT_MODE=layer
LLAMA_TENSOR_SPLIT=1,1,1
LLAMA_PARALLEL=1
LLAMA_ENABLE_SLOTS=true
LLAMA_FIT=on
LLAMA_CACHE_TYPE_K=q4_0
LLAMA_CACHE_TYPE_V=q4_0
LLAMA_REASONING=on
LLAMA_TEMP=0.6
LLAMA_TOP_P=0.95
LLAMA_TOP_K=20
LLAMA_MIN_P=0.0
LLAMA_REPEAT_PENALTY=1.0
LLAMA_OVERRIDE_KV=

# Speculative decoding — НЕСОВМЕСТИМО с гибридными SSM моделями (Qwen3.5-122B, Qwen3-Coder-Next).
# Ошибка: "the target context does not support partial sequence removal"
# Причина: ssm_d_state в модели — гибридные recurrent-слои требуют полного KV-state,
#           speculative decoding не может откатить rejected tokens.
# Статус: проверено 2026-04-13, задокументировано в decision-log.md D-016.
# НЕ раскомментировать — это не поможет.
#LLAMA_DRAFT_MODEL_PATH=/models_<user>/Qwen3-0.6B-GGUF/Qwen_Qwen3-0.6B-Q4_K_M.gguf
#LLAMA_DRAFT_GPU_LAYERS=100
#LLAMA_DRAFT_MAX=16
#LLAMA_DRAFT_MIN=5
#LLAMA_DRAFT_P_MIN=0.75

# === Proxy: DELETED (2026-06-18) ===
# llm-proxy-p4001 был избыточен — gemma-4 доступен напрямую на :8001.
# Для клиентов используется напрямую :8001 или LB-прокси :4002.

OPENWEBUI_ENABLED=true
OPENWEBUI_CONTAINER=open-webui-p3001
OPENWEBUI_IMAGE=open-webui:tst
OPENWEBUI_HOST_PORT=3001
OPENWEBUI_CONTAINER_PORT=8080
OPENWEBUI_GPU_DEVICES=2
OPENWEBUI_DATA_VOLUME=open-webui-p3001
OPENWEBUI_EMBEDDING_HOST_DIR=/data/shared/<user>/models/multilingual-e5-large
OPENWEBUI_OPENAI_BASE_URLS="http://host.docker.internal:8001/v1;http://host.docker.internal:8022/v1;http://bm1:8001/v1"
OPENWEBUI_OPENAI_API_KEY=dummy
OPENWEBUI_WEBUI_AUTH=true
OPENWEBUI_OFFLINE_MODE=true
OPENWEBUI_HF_HUB_OFFLINE=1
OPENWEBUI_RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-large
OPENWEBUI_RAG_EMBEDDING_MODEL_AUTO_UPDATE=false
OPENWEBUI_RAG_EMBEDDING_MODEL_TRUST_REMOTE_CODE=false
OPENWEBUI_WHISPER_MODEL_AUTO_UPDATE=false
OPENWEBUI_ENABLE_VERSION_UPDATE_CHECK=false

# bm remote nodes (SSH-managed)
BM1_HOST=<user>@bm1
BM1_CONTAINER=llamacpp-server-p8001
BM2_HOST=<user>@bm2
BM2_CONTAINER=llamacpp-server-p8001
